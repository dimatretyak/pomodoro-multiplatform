{
  "name": "pomidoro",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test src/*.test.ts",
    "cert": "mkdir -p .cert && openssl req -x509 -newkey rsa:2048 -nodes -days 365 -keyout .cert/key.pem -out .cert/cert.pem -subj /CN=pomidoro-dev -addext \"subjectAltName=DNS:localhost,IP:127.0.0.1,IP:$(ipconfig getifaddr en0 || echo 127.0.0.1)\"",
    "dev:https": "HTTPS=1 vite --host",
    "preview:https": "vite build && HTTPS=1 vite preview --host"
  },
  "type": "module",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "private": true
}
